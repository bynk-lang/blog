---
// A compact list of published posts: all of them newest first, or one
// series in reading order (oldest first). Each item shows its series (when
// the list isn't already one series) and who it's written for.
import { SERIES, href, levelTitle, posts } from "../lib/ladder";

interface Props {
  series?: keyof typeof SERIES;
  limit?: number;
  empty?: string;
}

const { series, limit, empty = "Nothing here yet." } = Astro.props;

// Excerpts are short Markdown strings; the only Markdown they use is `code`.
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inlineCode = (text: string) => escape(text).replace(/`([^`]+)`/g, "<code>$1</code>");
const all = await posts();
const matching = series ? all.filter((post) => post.data.series === series).reverse() : all;
const shown = limit ? matching.slice(0, limit) : matching;
---

{
  shown.length === 0 ? (
    <p class="post-list-empty">{empty}</p>
  ) : (
    <ul class="post-list">
      {shown.map((post) => {
        const postSeries = !series && post.data.series ? SERIES[post.data.series].title : undefined;
        const level = post.data.level ? levelTitle(post.data.level) : undefined;
        return (
          <li>
            <a href={href(post)}>{post.data.title}</a>
            {(postSeries || level) && (
              <p class="post-list-meta">{[postSeries, level].filter(Boolean).join(" · ")}</p>
            )}
            {post.data.excerpt && <p set:html={inlineCode(post.data.excerpt)} />}
          </li>
        );
      })}
    </ul>
  )
}
