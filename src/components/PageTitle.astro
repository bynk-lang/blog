---
// Starlight's page title, with the post's series above it. A post's title is
// its own point ("Who gets the penny?"), so the series name, which used to be
// part of the title, appears here instead, linking to the series on the home
// page (SeriesSections gives each section the series id as its anchor).
//
// The series comes after the <h1> in the markup and is shown above it with
// CSS (blog.css, .post-title). "Skip to content" and the table of contents
// jump to the <h1>, so a screen reader starting there still hears the series
// straight after the title.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { SERIES } from "../lib/ladder";

const id = Astro.locals.starlightRoute.entry.data.series;
const series = id ? SERIES[id] : undefined;
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

{
  series ? (
    <div class="post-title">
      <Default />
      <p class="series-kicker">
        <a href={`${home}#${id}`}>{series.title}</a>
      </p>
    </div>
  ) : (
    <Default />
  )
}
