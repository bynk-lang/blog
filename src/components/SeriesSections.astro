---
// One section per series, in the order SERIES lists them. A series with no
// published posts yet is left out, so the home page never shows an empty one.
import PostList from "./PostList.astro";
import { SERIES, posts } from "../lib/ladder";

const all = await posts();
const shown = Object.entries(SERIES).filter(([id]) => all.some((post) => post.data.series === id));
---

{
  shown.map(([id, series]) => (
    <section class="series">
      <h2 id={id}>{series.title}</h2>
      <p>{series.blurb}</p>
      <PostList series={id} />
    </section>
  ))
}
