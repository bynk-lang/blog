---
// Starlight's content area. On a blog post, starlight-blog's own component
// renders it (date, author, tags, previous and next links), as its plugin
// would if this override didn't exist. On a post in a series, SeriesNav adds
// the series' own previous and next posts, which replace the plugin's
// date-ordered links (hidden in blog.css when SeriesNav is present).
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import BlogMarkdownContent from "starlight-blog/components/MarkdownContent.astro";
import SeriesNav from "./SeriesNav.astro";

const { entry } = Astro.locals.starlightRoute;
const isPost = entry.id.startsWith("posts/") && entry.data.date !== undefined;
---

{
  isPost ? (
    <BlogMarkdownContent>
      <slot />
      <SeriesNav />
    </BlogMarkdownContent>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}
