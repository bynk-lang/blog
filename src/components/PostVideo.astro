---
// A link to a post's YouTube video, at the top of the post (its `video` field;
// see src/content.config.ts). Rendered by MarkdownContent.astro.
//
// The post links to the video rather than embedding it, so the page loads
// nothing from YouTube and sets no YouTube cookies.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<p class="post-video not-content" data-pagefind-ignore>
  <a href={`https://www.youtube.com/watch?v=${id}`}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M8 5v14l11-7z" fill="currentColor" />
    </svg>
    Watch on YouTube
  </a>
</p>
