---
// The end of a post in a series: where it sits in the series, and the series'
// previous and next posts. Renders nothing for a post outside a series.
import { LinkCard, CardGrid } from "@astrojs/starlight/components";
import { SERIES, href, seriesHref, seriesPosts } from "../lib/ladder";

const { entry } = Astro.locals.starlightRoute;
const id = entry.data.series;
const list = id ? await seriesPosts(id) : [];
const index = list.findIndex((post) => post.id === entry.id);
const prev = index > 0 ? list[index - 1] : undefined;
const next = index >= 0 ? list[index + 1] : undefined;
// A series may open with a prologue (`prologue` in SERIES): it isn't counted
// as a part, so the first part after it is Part 1.
const prologue = id ? (SERIES[id] as { prologue?: string }).prologue : undefined;
const offset = prologue && list[0]?.id === prologue ? 1 : 0;
const isPrologue = offset === 1 && index === 0;
---

{
  id && index >= 0 && (
    <nav class="series-nav" aria-label={`More from ${SERIES[id].title}`} data-pagefind-ignore>
      <p>
        {isPrologue ? "The prologue to" : `Part ${index + 1 - offset} of ${list.length - offset} in`}{" "}
        <a href={seriesHref(id)}>{SERIES[id].title}</a>
      </p>
      {(prev || next) && (
        <CardGrid>
          {prev && <LinkCard href={href(prev)} title={prev.data.title} description="Previous in the series" />}
          {next && <LinkCard href={href(next)} title={next.data.title} description="Next in the series" />}
        </CardGrid>
      )}
    </nav>
  )
}
